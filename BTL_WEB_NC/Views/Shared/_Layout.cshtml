@* [AI] Claude hỗ trợ – Module 1 (Nguyễn Thành Đạt) *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Cà Phê Mây – Nền tảng quản lý quán cà phê SaaS đa chi nhánh")</title>
    @if (ViewData["Description"] != null)
    {
        <meta name="description" content="@ViewData["Description"]" />
    }
    else
    {
        <meta name="description" content="Nền tảng quản lý chuỗi quán cà phê tinh gọn đa chi nhánh theo mô hình SaaS: quản lý bàn, menu QR, trừ kho tự động, báo cáo doanh thu." />
    }
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-body">
    <header class="public-header">
        <div class="public-nav-container">
            <a href="/" class="brand-link">
                <span class="brand-icon">☕</span>
                <span class="brand-text">Cà Phê Mây</span>
            </a>
            <nav class="public-nav">
                <a href="/#features" class="nav-link">Tính năng</a>
                <a href="/#pricing" class="nav-link">Bảng giá</a>
                <a href="/#faq" class="nav-link">Hỏi đáp</a>
            </nav>
            <div class="public-nav-actions">
                <a href="/dang-nhap" class="btn btn-secondary">Đăng nhập</a>
                <a href="/dang-ky" class="btn btn-primary">Đăng ký dùng thử</a>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <div class="footer-col">
                <div class="brand-link">
                    <span class="brand-icon">☕</span>
                    <span class="brand-text">Cà Phê Mây</span>
                </div>
                <p class="footer-desc">Nền tảng quản lý chuỗi quán cà phê tinh gọn, thông minh và tiết kiệm chi phí.</p>
                <p class="footer-copy">&copy; 2026 Cà Phê Mây. Nhóm WNC.G12 – FIT HOU.</p>
            </div>
            <div class="footer-col">
                <h4 class="footer-heading">Sản phẩm</h4>
                <ul class="footer-links">
                    <li><a href="/#features">Quản lý chuỗi</a></li>
                    <li><a href="/#features">Thực đơn điện tử QR</a></li>
                    <li><a href="/#features">Quản lý kho nguyên liệu</a></li>
                    <li><a href="/#pricing">Bảng giá dịch vụ</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4 class="footer-heading">Hệ thống</h4>
                <ul class="footer-links">
                    <li><a href="/dang-nhap">Đăng nhập</a></li>
                    <li><a href="/dang-ky">Đăng ký mở quán</a></li>
                    <li><a href="/sitemap.xml">Sitemap</a></li>
                    <li><a href="/robots.txt">Robots.txt</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="~/js/ajax.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
