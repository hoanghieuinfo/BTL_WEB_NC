@* [AI] Claude hỗ trợ – Module 1 (Nguyễn Thành Đạt) *@
@* [AI] Claude hỗ trợ – Phụ lục Z.7 (D3: dùng _AuthLayout như trang đăng nhập, bỏ style inline) *@
@model BTL_WEB_NC.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_AuthLayout";
    var mustChange = User.HasClaim(c => c.Type == BTL_WEB_NC.Infrastructure.Tenancy.TenantClaimTypes.MustChangePassword);
}

<h1 class="auth-title">Đổi mật khẩu</h1>
<p class="muted">
    @(mustChange
        ? "Tài khoản đang dùng mật khẩu khởi tạo. Hãy đổi mật khẩu để tiếp tục."
        : "Đặt mật khẩu mới cho tài khoản của bạn.")
</p>

@* asp-action (không ghi action="...") để tag helper tự thêm anti-forgery token *@
<form method="post" asp-controller="Account" asp-action="ChangePassword" class="form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="field">
        <label asp-for="CurrentPassword" class="field-label">Mật khẩu hiện tại <span class="required">*</span></label>
        <input asp-for="CurrentPassword" type="password" class="input" required autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="NewPassword" class="field-label">Mật khẩu mới <span class="required">*</span></label>
        <input asp-for="NewPassword" type="password" class="input" required autocomplete="new-password" aria-describedby="new-password-hint" />
        <span class="field-hint" id="new-password-hint">Tối thiểu 8 ký tự, có chữ hoa, chữ thường và chữ số.</span>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="ConfirmNewPassword" class="field-label">Nhập lại mật khẩu mới <span class="required">*</span></label>
        <input asp-for="ConfirmNewPassword" type="password" class="input" required autocomplete="new-password" />
        <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Cập nhật mật khẩu</button>
</form>

@if (mustChange)
{
    @* R03: chưa đổi thì không vào được trang nào khác, nên luôn để lối thoát là đăng xuất. *@
    <form method="post" asp-controller="Account" asp-action="Logout" class="auth-alt">
        <button type="submit" class="btn btn-block">Đăng xuất</button>
    </form>
}
