@* [AI] Claude hỗ trợ – Module 1 (Nguyễn Thành Đạt) *@
@model BTL_WEB_NC.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu tài khoản – Cà Phê Mây";
}

<div class="auth-page">
    <div class="auth-card" style="max-width: 440px;">
        <div class="brand-link" style="justify-content: center; margin-bottom: 20px;">
            <span class="brand-icon">☕</span>
            <span class="brand-text">Cà Phê Mây</span>
        </div>

        <h2 class="auth-title text-center">Đổi mật khẩu tài khoản</h2>
        <p class="muted text-center" style="font-size: 13px;">Bạn cần đổi mật khẩu để bảo vệ an toàn cho tài khoản quán.</p>

        <form method="post" action="/tai-khoan/doi-mat-khau" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-box alert-danger"></div>

            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                <input asp-for="CurrentPassword" type="password" class="input" required autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">Mật khẩu mới <span class="text-danger">*</span></label>
                <input asp-for="NewPassword" type="password" class="input" required autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
                <span class="field-hint">Tối thiểu 8 ký tự, gồm ít nhất 1 chữ hoa, 1 chữ thường và 1 chữ số.</span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmNewPassword" class="form-label">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                <input asp-for="ConfirmNewPassword" type="password" class="input" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 16px;">
                Cập nhật mật khẩu &rarr;
            </button>
        </form>
    </div>
</div>
