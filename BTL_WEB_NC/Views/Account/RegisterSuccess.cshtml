@* [AI] Claude hỗ trợ – Module 1 (Nguyễn Thành Đạt) *@
@model BTL_WEB_NC.Models.RegisterTenantViewModel
@{
    ViewData["Title"] = "Đăng ký thành công – Chờ kích hoạt";
}

<div class="auth-page">
    <div class="auth-card text-center" style="max-width: 520px; padding: 40px 32px;">
        <div style="font-size: 48px; margin-bottom: 16px;">🎉</div>
        <h2 class="auth-title" style="color: var(--primary);">Đăng ký mở quán thành công!</h2>
        <p class="muted" style="margin: 12px 0 24px; font-size: 15px; line-height: 1.6;">
            Chào mừng bạn đến với <strong>CafeSaaS</strong>. Yêu cầu mở quán <strong>@Model.ShopName</strong> (đường dẫn: <code>@Model.Slug</code>) đã được hệ thống ghi nhận.
        </p>

        <div class="alert-box" style="background: #FEF3C7; border: 1px solid #FDE68A; color: #92400E; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: left; font-size: 14px;">
            <strong>⏳ Trạng thái: Chờ kích hoạt</strong><br />
            Quản trị viên hệ thống (Super Admin) sẽ kiểm duyệt và kích hoạt tài khoản của bạn trong thời gian sớm nhất. Sau khi kích hoạt, bạn có thể đăng nhập bằng email <strong>@Model.Email</strong>.
        </div>

        <div style="display: flex; gap: 12px; justify-content: center;">
            <a href="/" class="btn btn-secondary">Về trang chủ</a>
            <a href="/dang-nhap" class="btn btn-primary">Đến trang đăng nhập &rarr;</a>
        </div>
    </div>
</div>
