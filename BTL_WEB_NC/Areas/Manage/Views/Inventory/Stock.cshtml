@* [AI] Claude hỗ trợ – Phụ lục Z.7 *@
@* MH12 – Tồn kho theo chi nhánh (P06, P07, R19). Thẻ số liệu + danh sách tải bằng AJAX vào [data-stock-list]. *@
@model StockPageModel
@{
    ViewData["Title"] = "Kho nguyên liệu";
}
@section Styles {
    <link rel="stylesheet" href="~/css/manage/inventory.css" asp-append-version="true" />
}

<partial name="_InventoryHeader" model="Model.Header" />

@if (Model.Branches.Count == 0)
{
    <section class="card">
        <div class="state">
            <p class="state-title">Quán chưa có chi nhánh</p>
            <p>Tạo chi nhánh ở mục Chi nhánh và bàn để theo dõi tồn kho.</p>
            <a class="btn" href="/manage/branches">Đến Chi nhánh và bàn</a>
        </div>
    </section>
}
else
{
    <form class="card filter-bar stock-filter" data-filter-form role="search">
        <label class="filter-branch">
            <span class="filter-label">Chi nhánh:</span>
            <select class="select" name="branchId" aria-label="Chi nhánh">
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id">@b.Name@(b.IsActive ? "" : " (tạm ngưng)")</option>
                }
            </select>
        </label>
        <label class="search-field">
            <span class="visually-hidden">Tìm tên nguyên liệu</span>
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input type="search" class="input" name="q" placeholder="Tìm tên nguyên liệu..." maxlength="100" autocomplete="off" />
        </label>
        <label class="switch need-switch">
            <input type="checkbox" role="switch" name="needOnly" />
            <span class="switch-track" aria-hidden="true"></span>
            <span class="switch-text">Chỉ xem nguyên liệu cần nhập</span>
        </label>
    </form>

    <div data-stock-list aria-live="polite" aria-busy="true">
        <section class="card"><div class="state" role="status"><span class="spinner" aria-hidden="true"></span><span>Đang tải tồn kho...</span></div></section>
    </div>

    <aside class="card stock-note">
        <span class="stock-note-icon" aria-hidden="true">⚠</span>
        <div>
            <p class="stock-note-title">Lưu ý kiểm kê chênh lệch</p>
            <p>Tồn âm nghĩa là đã bán nhiều hơn số đã nhập; hãy kiểm kho và lập phiếu nhập bù.</p>
        </div>
    </aside>

    <template id="stock-loading-template">
        <section class="card"><div class="state" role="status"><span class="spinner" aria-hidden="true"></span><span>Đang tải tồn kho...</span></div></section>
    </template>

    <dialog class="modal" id="stock-detail-modal" aria-labelledby="stock-detail-title">
        <div class="modal-head">
            <div>
                <h2 class="modal-title" id="stock-detail-title">Chi tiết tồn kho</h2>
                <p class="modal-subtitle" data-detail-subtitle></p>
            </div>
            <button type="button" class="icon-btn modal-close" data-close aria-label="Đóng">✕</button>
        </div>
        <div class="modal-body stock-detail-body" data-detail-body aria-live="polite"></div>
        <div class="modal-foot">
            <button type="button" class="btn" data-close>Đóng</button>
            <a class="btn btn-primary" data-detail-import href="/manage/inventory/receipts/new">Nhập hàng</a>
        </div>
    </dialog>
}

@section Scripts {
    <script src="~/js/manage/inventory-stock.js" asp-append-version="true"></script>
}
