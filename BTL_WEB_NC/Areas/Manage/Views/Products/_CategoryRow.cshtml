@* [AI] Claude hỗ trợ – Phụ lục Z.7 *@
@* Một dòng danh mục. Dùng cho lần render đầu và làm <template> để JS nhân bản. *@
@model CategorySummary
<li class="category-row" data-category-row="@Model.Id" data-sort="@Model.SortOrder">
    <button type="button" class="category-item" data-category-id="@Model.Id" aria-pressed="false">
        <span class="category-name" data-field="name">@Model.Name</span>
        <span class="category-count"><span data-field="count">@Model.ProductCount</span> món</span>
    </button>
    <details class="row-menu">
        <summary class="icon-btn" aria-label="Tùy chọn danh mục" data-field="menu-label">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>
        </summary>
        <div class="row-menu-list">
            <button type="button" class="menu-item" data-action="edit-category">Sửa danh mục</button>
            <button type="button" class="menu-item menu-item-danger" data-action="delete-category">Xóa danh mục</button>
        </div>
    </details>
</li>
