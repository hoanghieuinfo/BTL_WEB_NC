@* [AI] Claude hỗ trợ – Phụ lục Z.7 *@
@* A06 – Partial View danh sách món. Razor tự mã hóa mọi dữ liệu (kể cả trong data-*), nên JS được phép chèn nguyên khối này. *@
@using System.Globalization
@model ProductListResult
@{
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => value.ToString("#,##0", vi) + " đ";

    // Số trang hiển thị: 1 … (trang-1) trang (trang+1) … cuối
    var pages = new List<int?>();
    for (var p = 1; p <= Model.TotalPages; p++)
    {
        if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 1)
        {
            pages.Add(p);
        }
        else if (pages.Count > 0 && pages[^1] is not null)
        {
            pages.Add(null);
        }
    }
}

@if (Model.TotalCount == 0)
{
    <div class="state state-empty" data-list-meta data-total="0">
        <svg class="icon state-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4l10 10" /><path d="M14 4c-2 2-2 4 0 6s4 2 6 0" /><path d="M14 14l6 6" /><path d="M4 20l7-7" /></svg>
        @if (Model.Query.HasFilter)
        {
            <p class="state-title">Không tìm thấy món phù hợp</p>
            <p>Thử đổi từ khóa hoặc bỏ bớt bộ lọc.</p>
            <button type="button" class="btn" data-action="clear-filters">Xóa bộ lọc</button>
        }
        else
        {
            <p class="state-title">Chưa có món nào</p>
            <p>Thêm món đầu tiên để bắt đầu bán hàng.</p>
            <button type="button" class="btn btn-primary" data-action="add-product">+ Thêm món</button>
        }
    </div>
    return;
}

<table class="product-table" data-list-meta data-total="@Model.TotalCount" data-page="@Model.Page">
    <thead>
        <tr>
            <th scope="col">Món ăn &amp; định lượng</th>
            <th scope="col" class="col-price">Giá bán</th>
            <th scope="col" class="col-status">Trạng thái</th>
            <th scope="col" class="col-actions">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Items)
        {
            <tr class="product-row @(p.HasRecipe ? "" : "is-missing")"
                data-id="@p.Id" data-name="@p.Name" data-category-id="@p.CategoryId" data-price="@p.Price.ToString("0", CultureInfo.InvariantCulture)"
                data-description="@p.Description" data-available="@(p.IsAvailable ? "true" : "false")"
                data-image="@p.ImagePath" data-order-count="@p.OrderCount">
                <td class="col-product">
                    <div class="product-cell">
                        @if (string.IsNullOrEmpty(p.ImagePath))
                        {
                            <span class="product-thumb product-thumb-empty" aria-hidden="true">@p.Name[..1]</span>
                        }
                        else
                        {
                            <img class="product-thumb" src="@p.ImagePath" alt="Ảnh món @p.Name" width="48" height="48" loading="lazy" />
                        }
                        <div class="product-info">
                            <span class="product-name">@p.Name</span>
                            @if (p.HasRecipe)
                            {
                                <span class="product-meta">Định lượng: @p.RecipeCount nguyên liệu</span>
                            }
                            else
                            {
                                <span class="product-meta product-meta-warn"><span aria-hidden="true">⚠</span> Chưa có định lượng – bán không trừ kho</span>
                            }
                            <span class="product-price-mobile">@Money(p.Price)</span>
                        </div>
                    </div>
                </td>
                <td class="col-price"><span class="product-price">@Money(p.Price)</span></td>
                <td class="col-status">
                    <label class="switch">
                        <input type="checkbox" role="switch" data-action="toggle-available" checked="@p.IsAvailable"
                               aria-label="Đang bán: @p.Name" />
                        <span class="switch-track" aria-hidden="true"></span>
                        <span class="switch-text" data-available-text>@(p.IsAvailable ? "Đang bán" : "Ngừng bán")</span>
                    </label>
                </td>
                <td class="col-actions">
                    <div class="row-actions">
                        <button type="button" class="btn btn-sm" data-action="edit">Sửa</button>
                        <button type="button" class="btn btn-sm @(p.HasRecipe ? "" : "btn-warn")" data-action="recipe">Định lượng</button>
                        <button type="button" class="btn btn-sm btn-danger btn-icon" data-action="delete" aria-label="Xóa món @p.Name">
                            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16" /><path d="M9 7V4h6v3" /><path d="M6 7l1 13h10l1-13" /><path d="M10 11v6" /><path d="M14 11v6" /></svg>
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav class="pagination" aria-label="Phân trang món">
    <p class="pagination-info">Hiển thị <strong>@Model.From–@Model.To</strong> trên <strong>@Model.TotalCount</strong> món</p>
    <div class="pagination-pages">
        <button type="button" class="page-btn" data-page="@(Model.Page - 1)" disabled="@(Model.Page <= 1)">‹ Trước</button>
        @foreach (var p in pages)
        {
            if (p is null)
            {
                <span class="page-gap" aria-hidden="true">…</span>
            }
            else if (p == Model.Page)
            {
                <button type="button" class="page-btn is-current" aria-current="page" data-page="@p">@p</button>
            }
            else
            {
                <button type="button" class="page-btn" data-page="@p" aria-label="Trang @p">@p</button>
            }
        }
        <button type="button" class="page-btn" data-page="@(Model.Page + 1)" disabled="@(Model.Page >= Model.TotalPages)">Sau ›</button>
    </div>
</nav>
