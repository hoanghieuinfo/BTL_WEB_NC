@* [AI] Claude hỗ trợ – Module 1 (Nguyễn Thành Đạt) *@
@* [AI] Claude hỗ trợ – Phụ lục Z.7 (D3: cùng khung với _ManageLayout, bỏ style/script inline) *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var title = ViewData["Title"] as string ?? "Hệ thống Quản trị SaaS";
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? "Dashboard";
    var fullName = User.FindFirst(BTL_WEB_NC.Infrastructure.Tenancy.TenantClaimTypes.FullName)?.Value ?? "Super Admin";

    var nav = new[]
    {
        (Controller: "Dashboard", Href: "/system", Text: "Tổng quan hệ thống", Icon: "dashboard"),
        (Controller: "Tenants", Href: "/system/tenants", Text: "Quản lý Tenant", Icon: "store"),
        (Controller: "Plans", Href: "/system/plans", Text: "Gói dịch vụ", Icon: "menu"),
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@title – CafeSaaS System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/system/system.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="manage system-area">
    <a class="skip-link" href="#main">Bỏ qua menu</a>

    <aside class="sidebar" id="sidebar" aria-label="Menu Super Admin">
        <div class="sidebar-brand">
            <span class="brand-logo" aria-hidden="true">☕</span>
            <div class="brand-text">
                <span class="brand-name">CafeSaaS</span>
                <span class="brand-sub">Quản trị nền tảng</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            @foreach (var item in nav)
            {
                var active = string.Equals(item.Controller, currentController, StringComparison.OrdinalIgnoreCase);
                <a href="@item.Href" class="nav-link @(active ? "is-active" : "")" aria-current="@(active ? "page" : null)">
                    <partial name="~/Areas/Manage/Views/Shared/_Icon.cshtml" model="item.Icon" />
                    <span>@item.Text</span>
                </a>
            }
        </nav>

        <div class="sidebar-foot">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Super Admin</span>
        </div>
    </aside>
    <div class="sidebar-backdrop" data-sidebar-close hidden></div>

    <div class="shell">
        <header class="topbar">
            <button type="button" class="icon-btn topbar-menu" aria-controls="sidebar" aria-expanded="false"
                    aria-label="Mở menu" data-sidebar-toggle>
                <partial name="~/Areas/Manage/Views/Shared/_Icon.cshtml" model="@("hamburger")" />
            </button>

            <div class="topbar-brand">
                <span class="brand-logo" aria-hidden="true">☕</span>
                <div class="brand-text">
                    <span class="brand-name">CafeSaaS</span>
                    <span class="brand-sub">Quản trị nền tảng</span>
                </div>
            </div>

            <nav class="breadcrumb breadcrumb-top" aria-label="Đường dẫn">
                <a href="/system">Hệ thống</a><span class="breadcrumb-sep" aria-hidden="true">/</span><span aria-current="page">@title</span>
            </nav>

            <details class="user-menu">
                <summary aria-label="Tài khoản">
                    <span class="user-text">
                        <span class="user-name">@fullName</span>
                        <span class="user-role">Super Admin</span>
                    </span>
                    <span class="avatar" aria-hidden="true">SA</span>
                </summary>
                <div class="user-dropdown">
                    <form method="post" asp-area="" asp-controller="Account" asp-action="Logout">
                        <button type="submit" class="menu-item">Đăng xuất</button>
                    </form>
                </div>
            </details>
        </header>

        <main class="content" id="main">
            <nav class="breadcrumb breadcrumb-inline" aria-label="Đường dẫn">
                <a href="/system">Hệ thống</a><span class="breadcrumb-sep" aria-hidden="true">/</span><span aria-current="page">@title</span>
            </nav>
            @RenderBody()
        </main>
    </div>

    <div class="toast-region" id="toast-region" role="status" aria-live="polite"></div>

    @* Khung trang và hộp thoại dùng chung với Area Manage (cùng cấu trúc sidebar, dialog.modal, data-close). *@
    <script src="~/js/ajax.js" asp-append-version="true"></script>
    <script src="~/js/manage/layout.js" asp-append-version="true"></script>
    <script src="~/js/manage/ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
