@* [AI] Claude hỗ trợ – Module 1 (Nguyễn Thành Đạt) *@
@model IReadOnlyList<BTL_WEB_NC.Models.Entities.ServicePlan>
@{
    ViewData["Title"] = "Quản lý Gói dịch vụ";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Quản lý Gói dịch vụ</h1>
        <p class="page-subtitle muted">Thiết lập giá, giới hạn sử dụng và trạng thái cung cấp cho từng gói dịch vụ SaaS (BM02).</p>
    </div>
    <div class="page-actions">
        <button type="button" id="btn-add-plan" class="btn btn-primary">
            + Thêm gói dịch vụ mới
        </button>
    </div>
</div>

<!-- Lưới thẻ gói dịch vụ (MH07, Hình 3.18) -->
<div class="pricing-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 16px;">
    @foreach (var p in Model)
    {
        <div class="card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <div style="font-size: 28px;">
                    @(p.PricePerMonth == 0 ? "🌱" : p.Name == "Chuỗi" ? "👑" : "☕")
                </div>
                <div>
                    @if (p.IsActive)
                    {
                        <span class="badge" style="background: #E8F5E9; color: #2E7D32; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;">
                            ● Đang cung cấp
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="background: #FFEBEE; color: #C62828; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;">
                            ● Tạm ngưng
                        </span>
                    }
                </div>
            </div>

            <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 8px;">Gói @p.Name</h3>
            <div style="margin-bottom: 16px;">
                <strong style="font-size: 24px; color: var(--text);">@p.PricePerMonth.ToString("N0") đ</strong>
                <span class="muted" style="font-size: 13px;">/tháng</span>
            </div>

            <ul style="list-style: none; padding: 0; margin: 0 0 24px; font-size: 13px; color: var(--text-2);">
                <li style="padding: 6px 0; border-bottom: 1px solid #F0EEEB;">
                    🏢 Tối đa <strong>@p.MaxBranches chi nhánh</strong>
                </li>
                <li style="padding: 6px 0; border-bottom: 1px solid #F0EEEB;">
                    👥 Tối đa <strong>@p.MaxStaff nhân viên</strong>
                </li>
                <li style="padding: 6px 0;">
                    ⏳ @(p.TrialDays.HasValue ? $"{p.TrialDays.Value} ngày dùng thử" : "Không giới hạn ngày")
                </li>
            </ul>

            <div style="display: flex; gap: 8px;">
                <button type="button" class="btn btn-secondary btn-block btn-edit-plan"
                        data-id="@p.Id"
                        data-name="@p.Name"
                        data-branches="@p.MaxBranches"
                        data-staff="@p.MaxStaff"
                        data-price="@p.PricePerMonth"
                        data-trial="@(p.TrialDays ?? 0)"
                        data-active="@(p.IsActive ? "true" : "false")">
                    ✏️ Chỉnh sửa
                </button>
                <button type="button" class="btn btn-secondary btn-toggle-plan" data-id="@p.Id" title="Bật/Tắt cung cấp">
                    @(p.IsActive ? "Tắt" : "Bật")
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal thêm/sửa gói dịch vụ (MH07, Hình 3.19) -->
<dialog id="modal-plan-form" class="modal-sm" style="border: 1px solid var(--border); border-radius: var(--radius); padding: 0; background: var(--card); box-shadow: var(--shadow-lg);">
    <div style="padding: 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between;">
        <h3 id="plan-modal-title" style="font-size: 16px; margin: 0;">Chỉnh sửa gói dịch vụ</h3>
        <button type="button" class="icon-btn" onclick="document.getElementById('modal-plan-form').close();">✕</button>
    </div>
    <form id="plan-form" style="padding: 20px;" novalidate>
        <input type="hidden" id="plan-id" />

        <div class="form-group">
            <label class="form-label">Tên gói dịch vụ <span class="text-danger">*</span></label>
            <input type="text" id="plan-name" class="input" required maxlength="50" placeholder="Ví dụ: Gói Cơ bản" />
            <span class="field-error" id="plan-name-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Giá tham khảo/tháng (VNĐ) <span class="text-danger">*</span></label>
            <input type="number" id="plan-price" class="input" required min="0" step="1000" placeholder="0" />
            <span class="field-error" id="plan-price-error"></span>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label">Số chi nhánh tối đa <span class="text-danger">*</span></label>
                <input type="number" id="plan-branches" class="input" required min="1" />
                <span class="field-error" id="plan-branches-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Số nhân viên tối đa <span class="text-danger">*</span></label>
                <input type="number" id="plan-staff" class="input" required min="1" />
                <span class="field-error" id="plan-staff-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Số ngày dùng thử (bỏ trống nếu không giới hạn)</label>
            <input type="number" id="plan-trial" class="input" min="1" max="365" placeholder="Ví dụ: 30" />
            <span class="field-error" id="plan-trial-error"></span>
        </div>

        <div class="form-group">
            <label class="checkbox-label">
                <input type="checkbox" id="plan-active" checked />
                <span>Đang cung cấp (hiển thị để các quán đăng ký sử dụng)</span>
            </label>
        </div>
    </form>
    <div style="padding: 14px 20px; background: #FAF8F5; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-plan-form').close();">Hủy</button>
        <button type="button" id="btn-save-plan" class="btn btn-primary">Lưu thay đổi</button>
    </div>
</dialog>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('modal-plan-form');
            var modalTitle = document.getElementById('plan-modal-title');
            var planId = document.getElementById('plan-id');
            var planName = document.getElementById('plan-name');
            var planPrice = document.getElementById('plan-price');
            var planBranches = document.getElementById('plan-branches');
            var planStaff = document.getElementById('plan-staff');
            var planTrial = document.getElementById('plan-trial');
            var planActive = document.getElementById('plan-active');
            var btnSave = document.getElementById('btn-save-plan');

            function resetForm() {
                planId.value = '';
                planName.value = '';
                planPrice.value = '0';
                planBranches.value = '1';
                planStaff.value = '3';
                planTrial.value = '';
                planActive.checked = true;
                document.querySelectorAll('#plan-form .field-error').forEach(e => e.style.display = 'none');
            }

            document.getElementById('btn-add-plan').addEventListener('click', function () {
                resetForm();
                modalTitle.textContent = 'Thêm gói dịch vụ mới';
                modal.showModal();
            });

            document.querySelectorAll('.btn-edit-plan').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    resetForm();
                    modalTitle.textContent = 'Chỉnh sửa gói dịch vụ';
                    planId.value = this.getAttribute('data-id');
                    planName.value = this.getAttribute('data-name');
                    planPrice.value = this.getAttribute('data-price');
                    planBranches.value = this.getAttribute('data-branches');
                    planStaff.value = this.getAttribute('data-staff');
                    var trial = this.getAttribute('data-trial');
                    planTrial.value = trial && trial !== '0' ? trial : '';
                    planActive.checked = this.getAttribute('data-active') === 'true';
                    modal.showModal();
                });
            });

            document.querySelectorAll('.btn-toggle-plan').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = this.getAttribute('data-id');
                    try {
                        var res = await Ajax.postJson('/system/plans/' + id + '/toggle', {});
                        if (res.success) location.reload();
                    } catch (err) {
                        alert(err.message || 'Thao tác không thành công.');
                    }
                });
            });

            btnSave.addEventListener('click', async function () {
                var nameVal = planName.value.trim();
                if (!nameVal) {
                    var err = document.getElementById('plan-name-error');
                    err.textContent = 'Vui lòng nhập tên gói.';
                    err.style.display = 'block';
                    return;
                }

                var payload = {
                    id: planId.value ? parseInt(planId.value) : null,
                    name: nameVal,
                    pricePerMonth: parseFloat(planPrice.value) || 0,
                    maxBranches: parseInt(planBranches.value) || 1,
                    maxStaff: parseInt(planStaff.value) || 1,
                    trialDays: planTrial.value ? parseInt(planTrial.value) : null,
                    isActive: planActive.checked
                };

                btnSave.disabled = true;
                try {
                    var res = await Ajax.postJson('/system/plans/save', payload);
                    if (res.success) {
                        modal.close();
                        location.reload();
                    }
                } catch (err) {
                    alert(err.message || 'Lỗi lưu gói dịch vụ.');
                } finally {
                    btnSave.disabled = false;
                }
            });
        });
    </script>
}
